+// Atmark Pippin Controller: ADB scan codes for buttons in Byte2 and Byte3 of Talk 0
+// index = bit number(Byte2:bit15-8, Byte3:bit7-0), 0xFF = not assigned
+static const uint8_t pippin_keycode[16] = {
+    0x35,   // bit0  Square: Escape
+    0x24,   // bit1  Circle: Return
+    0xFF,   // bit2  Diamond: not assigned
+    0xFF,   // bit3  always 1
+    0xFF,   // bit4  always 1
+    0xFF,   // bit5  always 1
+    0xFF,   // bit6  always 1
+    0xFF,   // bit7  always 1
+    0x38,   // bit8  Blue: Shift
+    0x2C,   // bit9  Yellow: /
+    0x3E,   // bit10 Up: Up
+    0x2B,   // bit11 Left: ,
+    0x2F,   // bit12 Right: .
+    0x3D,   // bit13 Down: Down
+    0x36,   // bit14 Red: Control
+    0x31,   // bit15 Green: Space
+};
+static uint16_t pippin_buttons = 0xFFFF;
+
+static void pippin_proc_buttons(uint16_t buttons)
+{
+    // button state(0:pressed, 1:released)
+    uint16_t changed = buttons ^ pippin_buttons;
+    pippin_buttons = buttons;
+    for (uint8_t i = 0; i < 16; i++) {
+        if (!(changed & (1U << i))) continue;
+        uint8_t key = pippin_keycode[i];
+        if (key == 0xFF) continue;
+        register_key((buttons & (1U << i)) ? (key | 0x80) : key);
+    }
+}
+
 static report_mouse_t mouse_report = {};
 
